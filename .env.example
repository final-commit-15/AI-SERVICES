# AgentForge AI Services - Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=agentforge-ai-services
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/v1
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://agentforge:changeme@localhost:5432/agentforge

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=agentforge

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Ollama (Local Models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_GPU=1
OLLAMA_NUM_THREAD=4

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_TIMEOUT=60

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=60

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT=30

# Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
TOGETHER_MAX_RETRIES=3
TOGETHER_TIMEOUT=60

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT=60

# =============================================================================
# Model Router Configuration
# =============================================================================
DEFAULT_TASK_TYPE=general
DEFAULT_MODEL_PROVIDER=ollama
ROUTER_ENABLE_FALLBACK=true
ROUTER_FALLBACK_CHAIN=ollama,openai,anthropic,groq,together,openrouter
ROUTER_COST_OPTIMIZATION=true
ROUTER_LATENCY_OPTIMIZATION=false

ROUTER_CHAT_MODEL=ollama:qwen2.5:7b
ROUTER_CODING_MODEL=openai:gpt-4o
ROUTER_REASONING_MODEL=anthropic:claude-3.5-sonnet-20241022
ROUTER_SUMMARIZATION_MODEL=ollama:qwen2.5:7b
ROUTER_VISION_MODEL=ollama:llava:7b
ROUTER_EMBEDDING_MODEL=ollama:nomic-embed-text
ROUTER_SPEECH_MODEL=openai:whisper-1
ROUTER_IMAGE_GEN_MODEL=openai:dall-e-3

# =============================================================================
# Caching Configuration
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000
CACHE_REDIS_ENABLED=true

# =============================================================================
# Guardrails Configuration
# =============================================================================
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
GUARDRAILS_MAX_INPUT_LENGTH=10000
GUARDRAILS_MAX_OUTPUT_LENGTH=50000
GUARDRAILS_BLOCK_INJECTION=true
GUARDRAILS_BLOCK_PII=true
GUARDRAILS_BLOCK_TOXICITY=true

# =============================================================================
# Embeddings Configuration
# =============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_ENABLED=true

# =============================================================================
# RAG Configuration
# =============================================================================
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_HYBRID_SEARCH=true
RAG_VECTOR_STORE=qdrant
RAG_COLLECTION_NAME=documents

# =============================================================================
# Conversation Memory Configuration
# =============================================================================
MEMORY_ENABLED=true
MEMORY_BACKEND=redis
MEMORY_SHORT_TERM_TTL=3600
MEMORY_LONG_TERM_TTL=2592000
MEMORY_MAX_MESSAGES=50
MEMORY_SUMMARIZATION_ENABLED=true
MEMORY_SUMMARIZATION_MODEL=ollama:qwen2.5:7b

# =============================================================================
# Tool Calling Configuration
# =============================================================================
TOOLS_ENABLED=true
TOOLS_TIMEOUT=30
TOOLS_MAX_ITERATIONS=10

# =============================================================================
# Speech Configuration
# =============================================================================
SPEECH_PROVIDER=openai
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=tts-1
SPEECH_TTS_VOICE=alloy
SPEECH_MAX_FILE_SIZE=25MB

# =============================================================================
# Image Generation Configuration
# =============================================================================
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=dall-e-3
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_QUALITY=standard
IMAGE_GEN_STYLE=vivid

# =============================================================================
# Provider Health Monitoring
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_FAILURE_THRESHOLD=3

# =============================================================================
# Usage Analytics & Cost Tracking
# =============================================================================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD_USD=100.0

# =============================================================================
# Authentication & Authorization
# =============================================================================
AUTH_ENABLED=true
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_ENABLED=true
API_KEY_HEADER=X-API-Key

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST=10

# =============================================================================
# Admin API Configuration
# =============================================================================
ADMIN_API_ENABLED=true
ADMIN_API_KEY=admin-secret-key-change-in-production
ADMIN_RATE_LIMIT=1000

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# =============================================================================
# Streaming Configuration
# =============================================================================
STREAMING_ENABLED=true
STREAMING_CHUNK_SIZE=1024
STREAMING_TIMEOUT=300

# =============================================================================
# File Upload Configuration
# =============================================================================
UPLOAD_MAX_SIZE=50MB
UPLOAD_ALLOWED_TYPES=pdf,txt,md,docx,html,json,csv
UPLOAD_DIR=/tmp/uploads

# =============================================================================
# External Services
# =============================================================================
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_APP_KEY=